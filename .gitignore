# ---- 依赖（体积大、可重装） ----
node_modules/
.venv/
venv/
**/__pycache__/
*.pyc
*.pyo

# ---- 构建产物（可重建） ----
# platform/web/dist/ 例外：**必须入库**。
# 服务器要「clone 下来自己装」，如果 dist 不在仓库里，就得在服务器上装 Node +
# npm ci + vite build（500 MB 依赖 + npm 源在国内经常抽风）。dist 只有 536 KB，
# 又是同源相对路径构建（不含任何本机地址），入库换掉整个 Node 依赖，值。
# 代价：改过前端源码后，记得本机 `cd platform/web && npm run build` 再提交 dist。
platform/web/dist-sso/
platform/deploy/**/build/
platform/deploy/**/dist/
platform/deploy/windows-native/payload/
platform/deploy/**/release/
platform/deploy/dist/
platform/_shots*/
platform/deploy/windows-native/_shots*/
_handoff/
# 临时脚本与抓取下来的第三方产物（tools/.tmp 里是调试残留）
**/.tmp/

# ---- 二进制交付物：GitHub 单文件 100MB 上限，离线包 366MB 永远不该进仓库 ----
*.zip
*.exe
*.msi
*.7z
*.tar
*.tar.gz

# ---- 本机私有配置（含本机地址/口令，只留示例与生产默认） ----
platform/web/.env.local
.env
.env.local
*.local
**/native.json

# ---- 运行时产物 ----
logs/
*.log
*.db
*.db-wal
*.db-shm
*.sqlite3
