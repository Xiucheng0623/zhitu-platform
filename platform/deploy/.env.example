# ============================================================================
# FORGE · 智途数据生产平台 —— 部署环境变量模板
# ----------------------------------------------------------------------------
# 复制为 .env 后填入真实值（install.sh 会自动生成强随机密钥，推荐直接跑它）。
# .env 永不入库、永不进备份包明文（backup.sh 里权限 600）。
# 模板里的 change_me 是防误提交哨兵：不改，服务启动即失败（刻意如此）。
#
# 端口约定：80/443 入口、8100 标注工作台。刻意避开 8080 与 3001
# （常见被占用端口），如需改请同时检查防火墙与 README 端口表。
# ============================================================================

# ---- 入口与地址 ------------------------------------------------------------
# 域名部署：填真实域名（需 DNS 里 A 记录指向本机），install.sh 会用
# Caddyfile.domain 并自动签发 HTTPS。纯 IP / 内网部署：留空。
DOMAIN=
# 域名部署必填：HTTPS 证书到期 / 签发异常的通知邮箱。Let's Encrypt 不校验
# 邮箱真伪，填假的也能签出证书，但通知会全部丢掉，出问题时没人知道。
# 留空时 install.sh 会提示输入；纯 IP 模式用不到。不要留 example.cn 占位值。
ACME_EMAIL=

# 对外地址（install.sh 会按 DOMAIN 自动填好，手工部署时自己写全）：
#   域名模式: PLATFORM_PUBLIC_URL=https://data.example.cn
#             LS_PUBLIC_URL=https://ls.data.example.cn
#   IP 模式:  PLATFORM_PUBLIC_URL=http://192.168.1.10
#             LS_PUBLIC_URL=http://192.168.1.10:8100
PLATFORM_PUBLIC_URL=
LS_PUBLIC_URL=

# 对外端口。443 仅域名模式使用（自动 HTTPS）。
HTTP_PORT=80
HTTPS_PORT=443
LS_PORT=8100

# 构建期镜像源（国内服务器保持默认；海外部署改回官方源）
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ---- 平台管理员（install.sh 用它建号；手工部署时跑 create-admin）----------
# 手机号即登录名。密码不填则 install.sh 自动生成并打印一次。
ADMIN_PHONE=
ADMIN_NAME=管理员
ADMIN_PASSWORD=

# ---- 中间层数据库 ----------------------------------------------------------
# 管理员账号只给 migrate 容器用（建角色 / 迁移）
ORCH_DB_ADMIN=forge_admin
ORCH_DB_PASSWORD=change_me_strong_db_admin
# 应用账号：无 superuser、无 bypassrls，由 000_roles.sql 创建
ORCH_APP_PASSWORD=change_me_strong_app

# ---- 认证 ------------------------------------------------------------------
# 三种模式：
#   native  本服务自签 JWT，手机号 + 密码登录（默认生产形态）
#   jwt     外部 IdP（Keycloak / 企业 SSO）签发 OIDC token
#   dev     演示 token，任何人可伪造角色 —— 绝不可上公网
FORGE_AUTH_MODE=native
FORGE_DEFAULT_TENANT=ent_forge

# native 模式必填：HS256 密钥，>= 32 字符。留空服务直接起不来（刻意如此，
# 不允许退化成一个谁都能签的固定密钥）。生成方式：
#   python3 -c "import secrets;print(secrets.token_hex(48))"
FORGE_JWT_SECRET=change_me_64_hex_chars
FORGE_JWT_ISSUER=forge-orchestrator
FORGE_JWT_AUDIENCE=forge-platform
# 会话有效期（分钟）。改密 / 停用会 bump token_version 让旧 token 立刻失效。
FORGE_JWT_TTL_MIN=480
# 登录防护：连续失败 N 次锁 M 分钟；密码最小长度（NIST SP 800-63B 下限）
FORGE_LOGIN_MAX_FAILURES=5
FORGE_LOGIN_LOCK_MIN=15
FORGE_PASSWORD_MIN_LEN=8

# 若 FORGE_AUTH_MODE=jwt 才需要下面四项（二选一：JWKS 推荐，支持密钥轮换）
FORGE_OIDC_ISSUER=
FORGE_OIDC_AUDIENCE=
FORGE_OIDC_JWKS_URL=
FORGE_OIDC_HS256_SECRET=

# ---- 企业统一登录（SSO，OIDC Relying Party）--------------------------------
# 场景：与集团另一个平台共用同一账号池，认证归对方、授权归本平台。
# id_token 只用来确认"你是谁"（sub），角色永远从 forge.users.roles 读。
# 四项全填才启用；全留空则关闭；只填一部分会在启动期直接报错
# —— 半配置的 SSO 比没配更危险（按钮亮着、点了登不进来）。
FORGE_SSO_ISSUER=
FORGE_SSO_CLIENT_ID=
FORGE_SSO_CLIENT_SECRET=
# 必须在对方 IdP 后台登记为允许的回调地址，逐字符一致
FORGE_SSO_REDIRECT_URI=
# 写进 forge.identities.provider 的逻辑名。一旦定下就不要改。
FORGE_SSO_PROVIDER=oidc
FORGE_SSO_SCOPE=openid profile email phone
# 声明名映射：不同 IdP 叫法不同（Keycloak: preferred_username，Azure: 各有各的）
FORGE_SSO_CLAIM_SUB=sub
FORGE_SSO_CLAIM_PHONE=phone_number
FORGE_SSO_CLAIM_EMAIL=email
FORGE_SSO_CLAIM_NAME=name
# 首次见到陌生 sub 是否自动建号。自动号只有 FORGE_SSO_JIT_ROLE 一个角色，
# 绝不吃 id_token 里的 roles 声明。人员不重合时建议 false，改由管理员开通。
FORGE_SSO_ALLOW_JIT=true
FORGE_SSO_JIT_ROLE=annotator
FORGE_SSO_FRONTEND_REDIRECT=/#/sso/callback
FORGE_SSO_STATE_TTL_S=600

# ---- Label Studio ----------------------------------------------------------
LS_DB_PASSWORD=change_me_strong_ls_db
# 1.23.2 起 SECRET_KEY 用于签发 JWT，升级时必须轮换（换了之后所有 token 失效）
LS_SECRET_KEY=change_me_strong_ls_secret
# LS 自带管理员（建项目/导入数据用；普通员工走平台 SSO，不需要这个号）
LS_ADMIN_EMAIL=forge@example.cn
LS_ADMIN_PASSWORD=change_me_strong_ls_admin
# 平台 ↔ LS 单点登录共享密钥（与 orchestrator 同一个值）
LS_SSO_SECRET=change_me_strong_sso
# orchestrator 调 LS API 用的长期 token。install.sh 会自动登录 LS 获取并写入；
# 手工部署时按 README「获取 LS API token」一节操作。留空则 LS 业务接口每
# 5 分钟 401（1.23 的 access token 只有 5 分钟，靠它续期）。
LS_REFRESH_TOKEN=
# LS webhook 回调签名校验
LS_WEBHOOK_SECRET=change_me_strong_webhook
# 定时对账间隔（秒）。webhook 之外的第二条路：回调丢了/被拦了/服务重启期间
# 漏掉的进度，最多滞后这个间隔就会自己追平。设 0 等于关掉兜底，不建议。
LS_SYNC_INTERVAL_S=300

# ---- 对象存储 --------------------------------------------------------------
MINIO_USER=forge
MINIO_PASSWORD=change_me_strong_minio
S3_BUCKET=forge-data
