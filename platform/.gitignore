# FORGE · 入库排除规则
# ---------------------------------------------------------------------------
# 原则：只排"明确不该在库里的东西"。交付/归档用白名单而不是黑名单 ——
# 黑名单一定会漏（历史上曾把 7 个测试库打进交付包）。

# ---- 密钥与本地配置 --------------------------------------------------------
# .env 里有数据库密码与 JWT 密钥。曾出现过"改了密码顺手 commit"的事故。
.env
.env.production
.env.staging
deploy/.env
# 注意：web/.env.local 是**刻意入库**的 —— 它只含 127.0.0.1 的本地地址，
# 作用是把"怎么接真后端"变成可复现的事实。不含任何密钥。

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
lsvenv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node -----------------------------------------------------------------
node_modules/
npm-debug.log*
.vite/

# 前端产物：由 npm run build 生成，不入库。
# 但 dist 是部署输入 —— 服务器上必须在 checkout 后构建一次。
web/dist/
# SSO 浏览器验证专用产物（API 指向本机后端 8303，绝不能拿去部署）
web/dist-sso/

# ---- 运行时数据 -----------------------------------------------------------
# 这些是**工具产出**，不是源码。
*.db
*.db-journal
*.sqlite3
labelstudio/data/
deploy/backup/

# 截图/临时产物（verify_*.py 的输出目录）
_shots/
_shots_sso/
web/_shots/
web/_shots_sso/
web/_shots-wired/
*.png.tmp

# ---- 编辑器 / 系统 --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
